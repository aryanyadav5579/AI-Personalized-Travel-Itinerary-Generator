# ============================================================
# AI Travel Planner — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file:   copy .env.example .env
#   2. Open .env and replace placeholder values with real keys
#   3. NEVER commit .env to Git (it is already in .gitignore)
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# Google Gemini API Key (FREE)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPTIONAL ─────────────────────────────────────────────────
# OpenWeatherMap API Key (for weather feature — app works without it)
# Free tier at: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# ── APP SETTINGS (no need to change) ─────────────────────────
APP_TITLE=AI Travel Planner
DEBUG_MODE=False
MAX_RETRIES=3
